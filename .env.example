DATABASE_URL="postgresql://llz_app:llz_app_dev_pw@localhost:5432/llz_clipper"
# Precisa de um usuário com permissão CREATEDB (ex: o superusuário do Postgres) -
# usado só por "prisma migrate dev" para criar/descartar o shadow database.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS="30"
PORT="3000"
