# Optional override for the API host the desktop app talks to. Defaults to
# http://localhost:3000 when unset. Set this when building/running the app
# against a non-local API (staging, a LAN host, etc.) without touching source.
#
# Vite only inlines env vars prefixed with VITE_ at build time — copy this
# file to .env (or .env.local) and set the value before running
# `npm run dev` / `npm run build` in this workspace.
VITE_API_BASE_URL="http://localhost:3000"
