DATABASE_URL="postgresql://llz_app:llz_app_dev_pw@localhost:5432/llz_clipper"
# Precisa de um usuário com permissão CREATEDB (ex: o superusuário do Postgres) -
# usado só por "prisma migrate dev" para criar/descartar o shadow database.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS="30"
PORT="3000"
# Opcional — se whisper-cli(.exe) já estiver no PATH, pode deixar em branco.
WHISPER_PATH="C:\caminho\para\whisper.cpp\build\bin\whisper-cli.exe"
# Obrigatório para a Fase 4 (transcrição) — baixe um modelo .bin com
# models/download-ggml-model.sh (ex: "base", multilíngue) no repositório do
# whisper.cpp e aponte para o arquivo baixado.
WHISPER_MODEL_PATH="C:\caminho\para\whisper.cpp\models\ggml-base.bin"
