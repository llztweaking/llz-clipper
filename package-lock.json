{
  "name": "llz-clipper",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "llz-clipper",
      "workspaces": [
        "apps/*",
        "services/*",
        "packages/*"
      ]
    },
    "apps/desktop": {
      "name": "@llz-clipper/desktop",
      "version": "0.0.0"
    },
    "node_modules/@llz-clipper/desktop": {
      "resolved": "apps/desktop",
      "link": true
    },
    "node_modules/@llz-clipper/worker": {
      "resolved": "services/worker",
      "link": true
    },
    "services/worker": {
      "name": "@llz-clipper/worker",
      "version": "0.0.0"
    }
  }
}
